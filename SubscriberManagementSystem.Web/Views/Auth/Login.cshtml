@model SubscriberManagementSystem.Web.ViewModel.Auth.LoginViewModel
@using SubscriberManagementSystem.Web.Resources
@using System.Globalization

@{
    Layout = null;
    var isRTL = CultureInfo.CurrentCulture.Name.StartsWith("ar");
}

<!DOCTYPE html>
<html lang="@(isRTL ? "ar" : "en")" direction="@(isRTL ? "rtl" : "ltr")" dir="@(isRTL ? "rtl" : "ltr")" style="direction: @(isRTL ? "rtl" : "ltr")">

<head>
    <base href="../../../">
    <title>@Global.SubscriberManagementSystem | @Global.LogIn</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="article" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />

    @if (isRTL)
    {
        <link href="~/assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" />
        <link href="~/assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" />
    }
    else
    {
        <link href="~/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
        <link href="~/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
    }
</head>

<body id="kt_body" class="bg-body">
    <div class="d-flex flex-column flex-root">
        <div class="d-flex flex-column flex-column-fluid bgi-position-y-bottom position-x-center bgi-no-repeat bgi-size-contain bgi-attachment-fixed" style="background-image: url(assets/media/illustrations/dozzy-1/14.png">
            <div class="d-flex flex-center flex-column flex-column-fluid p-10 pb-lg-20">
                <div class="w-lg-500px bg-body rounded shadow-sm p-10 p-lg-15 mx-auto">
                    <form id="loginForm" class="form w-100">
                        
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <div class="text-center mb-12">
                            <h1 class="text-dark mt-2">@Global.LoginToYourAccount</h1>
                        </div>

                        <!--begin::Validation Alert-->
                        @await Html.PartialAsync("_ValidationAlert")
                        <!--end::Validation Alert-->

                        <div class="fv-row mb-10">
                            <label class="form-label fs-5 fw-bolder text-dark">@Global.Email</label>
                            <input id="Email" asp-for="@Model.Email" class="form-control form-control-lg form-control-solid" type="text" autocomplete="off" placeholder="@Global.Email" />
                        </div>

                        <div class="fv-row mb-10">
                            <div class="d-flex flex-stack mb-2">
                                <label class="form-label fw-bolder text-dark fs-5 mb-0">@Global.Password</label>
                            </div>
                            <input asp-for="@Model.Password" class="form-control form-control-lg form-control-solid" type="password" autocomplete="off" placeholder="@Global.Password" />
                        </div>

                        <div class="text-center">
                            <button id="login-submit" type="submit" class="btn btn-lg btn-primary w-100 mb-5">
                                <span class="indicator-label fw-bolder">@Global.LogIn </span>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="d-flex flex-center flex-column-auto p-10">
                    <div class="d-flex align-items-center text-muted fw-bold fs-6">
                        SubscriberManagementSystem
                        <script>
                            document.write(" © " + new Date().getFullYear());
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/plugins/global/plugins.bundle.js"></script>
    <script src="~/assets/js/scripts.bundle.js"></script>
    <script src="~/js/Auth.js"></script>
    <script>
        $(document).ready(function () {
            auth.init();
            $('#Email').focus();
        });
    </script>
</body>
</html>
