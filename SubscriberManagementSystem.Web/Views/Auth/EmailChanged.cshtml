@model SubscriberManagementSystem.Web.ViewModel.Auth.LoginViewModel;
@using SubscriberManagementSystem.Web.Resources;
@using System.Globalization

@{
	Layout = null;
	var isRTL = CultureInfo.CurrentCulture.Name.StartsWith("ar");
}
<!DOCTYPE html>
<html lang="@(isRTL ? "ar" : "en")" direction="@(isRTL ? "rtl" : "ltr")" dir="@(isRTL ? "rtl" : "ltr")" style="direction: @(isRTL ? "rtl" : "ltr")">
<!--begin::Head-->
<head>
	<base href="../../../">
	<title> @Global.SubscriberManagementSystem | @Global.EmailIsChanged</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta property="og:locale" content="en_US" />
	<meta property="og:type" content="article" />
	<link rel="shortcut icon" href="~/favicon.ico" />

	<!--begin::Fonts-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
	<!--end::Fonts-->

	@if (isRTL)
	{
		<!--begin::Global Stylesheets Bundle(used by all pages)-->
		<link href="~/assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" />
		<link href="~/assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" />
		<!--end::Global Stylesheets Bundle-->
	}
	else
	{
		<!--begin::Global Stylesheets Bundle(used by all pages)-->
		<link href="~/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
		<link href="~/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
		<!--end::Global Stylesheets Bundle-->
	}
</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_body" class="auth-bg">
	<!--begin::Main-->
	<!--begin::Root-->
	<div class="d-flex flex-column flex-root">
		<div class="d-flex flex-column flex-column-fluid">
			<!--begin::Content-->
			<div class="d-flex flex-column flex-column-fluid text-center p-10 py-lg-15">
				<!--begin::Logo-->
				@*<a href="~/Home" class="mb-10 pt-lg-10">
					<img alt="Logo" src="" class="h-40px mb-5" />
				</a>*@
				<!--end::Logo-->
				<!--begin::Wrapper-->
				<div class="pt-lg-10 mb-10">
					<!--begin::Logo-->
					<h1 class="fw-bolder fs-2qx text-gray-800 mb-7">@Global.EmailIsChanged</h1>
					<!--end::Logo-->
					<!--begin::Message-->
					<div class="fw-bold fs-3 text-muted mb-15">
                        <div class="fs-2">@Global.YorEmailIsSuccessfullyChanged</div>
						 @Global.PleaseLogInToYourAccount
					</div>
					<!--end::Message-->
					<!--begin::Action-->
					<div class="text-center">
						<a href="~/Auth/Login" class="btn btn-primary btn-lg fw-bolder">@Global.LogIn</a>
					</div>
					<!--end::Action-->
					
				</div>
				<!--end::Wrapper-->
				<!--begin::Illustration-->
				<div class="d-flex flex-row-auto bgi-no-repeat bgi-position-x-center bgi-size-contain bgi-position-y-bottom min-h-100px min-h-lg-350px" style="background-image: url(assets/media/illustrations/dozzy-1/1.png"></div>
				<!--end::Illustration-->
			</div>
			<!--end::Content-->
			<!--begin::Footer-->
			<div class="d-flex flex-center flex-column-auto p-10 pt-5">
				<div class="d-flex align-items-center text-muted fw-bold fs-6">
					SubscriberManagementSystem
					<script>
						document.write(" © " + new Date().getFullYear());
					</script>
				</div>
			</div>
			<!--end::Footer-->
		</div>
	</div>
	<!--end::Root-->
	<!--end::Main-->
	<!--begin::Javascript-->
	<script>var hostUrl = "assets/";</script>
	<!--begin::Global Javascript Bundle(used by all pages)-->
	<script src="assets/plugins/global/plugins.bundle.js"></script>
	<script src="assets/js/scripts.bundle.js"></script>
	<!--end::Global Javascript Bundle-->
	<!--end::Javascript-->
</body>
<!--end::Body-->
</html>