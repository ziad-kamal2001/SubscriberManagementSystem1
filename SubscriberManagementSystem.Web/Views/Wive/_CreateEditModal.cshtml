@model SubscriberManagementSystem.Web.ViewModel.Wives.CreateEditWiveVM
@using SubscriberManagementSystem.Web.Resources;

<div class="modal-header">
    <div class="modal-title fw-bolder fs-3">
        <span class="card-icon me-2">
            <i class="bi bi-book fs-4"></i>
        </span>
        @if (Model.Wives.Id > 0)
        {
            @Global.EditRelative
        }
        else
        {
            @Global.AddRelative
        }
    </div>
    <!--begin::Close-->
    <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
        <span class="svg-icon svg-icon-2x">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor"></rect>
                <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor"></rect>
            </svg>
        </span>
    </div>
    <!--end::Close-->
</div>
<div class="modal-body">
    <form id="form">
        <!--begin::Validation Alert-->
        @await Html.PartialAsync("_ValidationAlert")
        <!--end::Validation Alert-->

        <input name="Id" asp-for="Wives.Id" type="hidden" />
        <input id="wiveBeneficiaryId" name="BeneficiaryId" asp-for="Wives.BeneficiaryId" type="hidden" />
        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.Name</label>
            </div>
            <div class="col-md-8">
                <input name="Name" asp-for="Wives.Name" type="text" placeholder="@Global.Name" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.IDNumber</label>
            </div>
            <div class="col-md-8">
                <input name="IDNumber" asp-for="Wives.IDNumber" type="text" placeholder="@Global.IDNumber" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.DOB</label>
            </div>
            <div class="col-md-8">
                <input name="DOB" asp-for="Wives.DOB" type="date" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.Status</label>
            </div>
            <div class="col-md-8">
                <div class="form-check form-check-custom form-check-solid form-check-sm">
                    <input name="IsActive" asp-for="Wives.IsActive" class="form-check-input" type="checkbox" id="IsActive" />
                    <label class="form-check-label fs-4" for="IsActive">
                        @Global.IsActive
                    </label>
                </div>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary fw-bolder fs-4" data-bs-dismiss="modal">@Global.Close</button>
            <button type="submit" class="btn btn-primary btnSubmit fw-bolder fs-4">@Global.Save</button>
        </div>
        <div class="text-end mt-5">
            <button type="button" class="btn btn-primary fw-bolder fs-5" onclick="$('#createEditForm').submit()">@Global.Save</button>
        </div>
    </form>
</div>