@model SubscriberManagementSystem.Web.ViewModel.User.CreateEditUserVM
@using SubscriberManagementSystem.Web.Resources;

@{
    var isNewUser = string.IsNullOrEmpty(Model.User.Id);
    var selectStatus = isNewUser ? "selected" : "";
}

<div class="modal-header">
    <div class="modal-title fw-bolder fs-3">
        <span class="card-icon me-2">
            <i class="bi bi-person-fill fs-4"></i>
        </span>
        @if (isNewUser)
        {
            @Global.AddUser
        }
        else
        {
            @Global.EditUser
        }
    </div>
    <!--begin::Close-->
    <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
        <span class="svg-icon svg-icon-2x">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor"></rect>
                <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor"></rect>
            </svg>
        </span>
    </div>
    <!--end::Close-->
</div>
<div class="modal-body block_ui">
    <form id="form" enctype="multipart/form-data">
        <!--begin::Validation Alert-->
        @await Html.PartialAsync("_ValidationAlert")
        <!--end::Validation Alert-->

        @if (!isNewUser)
        {
            <input type="hidden" asp-for="User.Id" name="Id" />
        }

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.Name</label>
            </div>
            <div class="col-md-8">
                <input name="Name" asp-for="User.Name" type="text" placeholder="@Global.Name" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.Email</label>
            </div>
            <div class="col-md-8">
                <input name="Email" asp-for="User.Email" type="text" placeholder="@Global.Email" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.PhoneNumber</label>
            </div>
            <div class="col-md-8">
                <input name="PhoneNumber" asp-for="User.PhoneNumber" type="text" placeholder="@Global.PhoneNumber" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.Password</label>
            </div>
            <div class="col-md-8">
                <input name="Password" asp-for="User.Password" type="password" placeholder="@Global.Password" class="form-control form-control-solid" />
            </div>
        </div>
       
        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.ConfirmPassword</label>
            </div>
            <div class="col-md-8">
                <input name="ConfirmPassword" asp-for="User.ConfirmPassword" type="password" placeholder="@Global.ConfirmPassword" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.UserType</label>
            </div>
            <div class="col-md-8">
                <select name="UserTypeId" asp-for="User.UserTypeId" class="form-select form-select-solid me-3 select2-modal" data-control="select2" data-dropdown-parent="#modal" data-dropdown-css-class="fs-4">
                    <option value="" selected="@selectStatus" disabled>@Global.UserType</option>
                    @foreach (var item in Model.UserTypes)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.Gender</label>
            </div>

            <div class="col-md-8">
                <div class="form-group fs-4 d-flex">
                    @foreach (var item in Model.Genders)
                    {
                        <div class="form-check form-check-custom form-check-solid form-check-sm me-3">
                            <label class="form-check-label" for="radio_@item.Id">
                                <input name="GenderId" asp-for="User.GenderId" type="radio" value="@item.Id" id="radio_@item.Id" class="form-check-input me-1" />
                                @item.Name
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder  mt-2 fs-4">@Global.Status</label>
            </div>
            <div class="col-md-8">
                <div class="form-check form-check-custom form-check-solid form-check-sm">
                    <input name="IsActive" asp-for="User.IsActive" class="form-check-input" type="checkbox" id="IsActive" />
                    <label class="form-check-label fs-4" for="IsActive">
                        @Global.IsActive
                    </label>
                </div>
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder  mt-2 fs-4">@Global.Avatar</label>
            </div>
            <div class="col-md-8">
                <input id="UploadAvatar" type="file" name="UploadAvatar" class="form-control" />
                <input type="hidden" name="Avatar" asp-for="User.Avatar" class="form-control" />
            </div>
        </div>
        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
            </div>
            <div class="col-md-8">
                @if (Model.User.Avatar == null)
                {
                    <img id="img" src="~/Images/default_avatar.png" height="110" />
                }
                else
                {
                    <input type="hidden" name="OldAvatar" value="@Model.User.Avatar" />
                    <img id="img" src="~/Images/@Model.User.Avatar" height="110" />
                }
                </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary fw-bolder fs-4" data-bs-dismiss="modal">@Global.Close</button>
            <button type="submit" class="btn btn-primary btnSubmit fw-bolder fs-4">@Global.Save</button>
        </div>
    </form>
</div>