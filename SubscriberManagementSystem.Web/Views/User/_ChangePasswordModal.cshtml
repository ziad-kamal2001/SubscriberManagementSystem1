@model SubscriberManagementSystem.Infrastructure.Services.Users.Dto.ChangePasswordDto
@using SubscriberManagementSystem.Web.Resources;

<div class="modal-header">
    <div class="modal-title fw-bolder fs-3">
        <span class="card-icon me-2">
            <i class="bi bi-key fs-4"></i>
        </span>
        @Global.ChangePassword
    </div>
    <!--begin::Close-->
    <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
        <span class="svg-icon svg-icon-2x">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <rect opacity="0.5" x="6" y="17.3137" width="16" height="2" rx="1" transform="rotate(-45 6 17.3137)" fill="currentColor"></rect>
                <rect x="7.41422" y="6" width="16" height="2" rx="1" transform="rotate(45 7.41422 6)" fill="currentColor"></rect>
            </svg>
        </span>
    </div>
    <!--end::Close-->
</div>
<div class="modal-body block_ui">
    <form id="changePasswordForm">
        <!--begin::Validation Alert-->
        @await Html.PartialAsync("_ValidationAlert")
        <!--end::Validation Alert-->

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.CurrentPassword</label>
            </div>
            <div class="col-md-8">
                <input name="CurrentPassword" asp-for="@Model.CurrentPassword" type="password" placeholder="@Global.CurrentPassword" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.NewPassword</label>
            </div>
            <div class="col-md-8">
                <input name="NewPassword" asp-for="@Model.NewPassword" type="password" placeholder="@Global.NewPassword" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="row form-group mb-5">
            <div class="col-md-4 text-center">
                <label class="control-label fw-bolder mt-2 fs-4">@Global.ConfirmPassword</label>
            </div>
            <div class="col-md-8">
                <input name="ConfirmPassword" asp-for="@Model.ConfirmPassword" type="password" placeholder="@Global.ConfirmPassword" class="form-control form-control-solid" />
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary fw-bolder fs-4" data-bs-dismiss="modal">@Global.Close</button>
            <button type="submit" class="btn btn-primary btnSubmit fw-bolder fs-4">@Global.Save</button>
        </div>
    </form>
</div>