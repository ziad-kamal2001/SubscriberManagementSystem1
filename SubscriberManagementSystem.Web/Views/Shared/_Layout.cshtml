@using SubscriberManagementSystem.Web.Resources;
@using System.Globalization

@{
	var isRTL = CultureInfo.CurrentCulture.Name.StartsWith("ar");
}
<!DOCTYPE html>
<html lang="@(isRTL ? "ar" : "en")" direction="@(isRTL ? "rtl" : "ltr")" dir="@(isRTL ? "rtl" : "ltr")" style="direction: @(isRTL ? "rtl" : "ltr")">
<!--begin::Head-->
<head>
	<base href="">
	<title> @Global.SubscriberManagementSystem | @ViewData["Title"]</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta property="og:locale" content="en_US" />
	<meta property="og:type" content="article" />
	<link rel="shortcut icon" href="~/favicon.ico" />
	<!--begin::Fonts-->
	<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" />
	<!--end::Fonts-->
	@if (isRTL)
	{
		<!--begin::Page Vendor Stylesheets(used by this page)-->
		<link href="~/assets/plugins/custom/datatables/datatables.bundle.rtl.css" rel="stylesheet" type="text/css" />
		<!--end::Page Vendor Stylesheets-->
		<!--begin::Global Stylesheets Bundle(used by all pages)-->
		<link href="~/assets/plugins/global/plugins.bundle.rtl.css" rel="stylesheet" type="text/css" />
		<link href="~/assets/plugins/custom/prismjs/prismjs.bundle.rtl.css" rel="stylesheet" type="text/css" />
		<link href="~/assets/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" />
		<link href="~/assets/css/custom.css" rel="stylesheet" type="text/css" />
		<!--end::Global Stylesheets Bundle-->
	}
	else
	{
		<!--begin::Page Vendor Stylesheets(used by this page)-->
		<link href="~/assets/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css" />
		<!--end::Page Vendor Stylesheets-->
		<!--begin::Global Stylesheets Bundle(used by all pages)-->
		<link href="~/assets/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
		<link href="~/assets/plugins/custom/prismjs/prismjs.bundle.css" rel="stylesheet" type="text/css" />
		<link href="~/assets/css/style.bundle.css" rel="stylesheet" type="text/css" />
		<link href="~/assets/css/custom.css" rel="stylesheet" type="text/css" />
		<!--end::Global Stylesheets Bundle-->
	}
</head>
<!--end::Head-->
<!--begin::Body-->
<body id="kt_body" data-kt-aside-minimize="on" class="header-fixed header-tablet-and-mobile-fixed toolbar-enabled toolbar-fixed aside-enabled aside-fixed" style="--kt-toolbar-height:55px;--kt-toolbar-height-tablet-and-mobile:55px">
	<!--begin::Main-->
	<!--begin::Root-->
	<div class="d-flex flex-column flex-root">
		<!--begin::Page-->
		<div class="page d-flex flex-row flex-column-fluid">
			
			<!--begin::Aside-->
			@await Html.PartialAsync("_Aside")
			<!--end::Aside-->
			
			<!--begin::Wrapper-->
			<div class="wrapper d-flex flex-column flex-row-fluid" id="kt_wrapper">
				
				<!--begin::Header-->
				@await Html.PartialAsync("_Header")
				<!--end::Header-->

				<!--begin::Content-->
				<div class="content d-flex flex-column flex-column-fluid" style="margin-top : -30px;" id="kt_content">
					<!--begin::Post-->
					<div class="post d-flex flex-column-fluid" id="kt_post">
						<!--begin::Container-->
						<div id="kt_content_container" class="container-xxl">
							@RenderBody()
						</div>
						<!--end::Container-->
					</div>
					<!--end::Post-->
				</div>
				<!--end::Content-->

				<!--begin::Footer-->
				@await Html.PartialAsync("_Footer")
				<!--end::Footer-->

			</div>
			<!--end::Wrapper-->
		</div>
		<!--end::Page-->
	</div>
	<!--end::Root-->
	<!--begin::Scrolltop-->
	<div id="kt_scrolltop" class="scrolltop" data-kt-scrolltop="true">
		<!--begin::Svg Icon | path: icons/duotune/arrows/arr066.svg-->
		<span class="svg-icon">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
				<rect opacity="0.5" x="13" y="6" width="13" height="2" rx="1" transform="rotate(90 13 6)" fill="currentColor" />
				<path d="M12.5657 8.56569L16.75 12.75C17.1642 13.1642 17.8358 13.1642 18.25 12.75C18.6642 12.3358 18.6642 11.6642 18.25 11.25L12.7071 5.70711C12.3166 5.31658 11.6834 5.31658 11.2929 5.70711L5.75 11.25C5.33579 11.6642 5.33579 12.3358 5.75 12.75C6.16421 13.1642 6.83579 13.1642 7.25 12.75L11.4343 8.56569C11.7467 8.25327 12.2533 8.25327 12.5657 8.56569Z" fill="currentColor" />
			</svg>
		</span>
		<!--end::Svg Icon-->
	</div>
	<!--end::Scrolltop-->
	<!--end::Main-->

	<div dir="@(isRTL ? "rtl" : "ltr")" id="shortcutsModal" class="modal fade" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title fs-3">
						@Global.Shortcutsf1
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="row">
						<div class="col-md-3">
							<p class="fs-4"><kbd>+</kbd> @Global.New</p>
						</div>
						<div class="col-md-3">
							<p class="fs-4"><kbd>Esc</kbd> @Global.Close</p>
						</div>
						<div class="col-md-3">
							<p class="fs-4"><kbd>Ctrl+Shift</kbd> @Global.Save</p>
						</div>
						<div class="col-md-3">
							<p class="fs-4"><kbd>Ctrl+p</kbd> @Global.Print</p>
						</div>
						<div class="col-md-3">
							<p class="fs-4"><kbd>Ctrl+↑</kbd> @Global.First</p>
						</div>
						<div class="col-md-3">
							<p class="fs-4"><kbd>Ctrl+↓</kbd> @Global.Last</p>
						</div>
						<div class="col-md-3">
							<p class="fs-4"><kbd>Ctrl+@(isRTL ? "→" : "←")</kbd> @Global.Previous</p>
						</div>
						<div class="col-md-3">
							<p class="fs-4"><kbd>Ctrl+@(isRTL ? "←" : "→")</kbd> @Global.Next</p>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-sm btn-secondary fw-bolder fs-4" data-bs-dismiss="modal">@Global.Close</button>
				</div>
			</div>
		</div>
	</div>

	<div id="modal" class="modal fade" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
			</div>
		</div>
	</div>

	<div id="modal-lg" class="modal fade" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
			</div>
		</div>
	</div>
	
	<!--begin::Javascript-->
	<!--begin::Global Javascript Bundle(used by all pages)-->
	<script src="~/assets/plugins/global/plugins.bundle.js"></script>
	<script src="~/assets/plugins/custom/prismjs/prismjs.bundle.js"></script>
	<script src="~/assets/js/scripts.bundle.js"></script>
    <script src="~/assets/js/toastroptions.js"></script>
    <script src="~/assets/hotkeys/dist/hotkeys.min.js"></script>
	<script src="~/js/General/General.js"></script>

	@await RenderSectionAsync("Scripts", required: false)
	<!--end::Global Javascript Bundle-->
	<script src="~/assets/plugins/custom/datatables/datatables.bundle.js"></script>

	@if (isRTL)
	{ 
		<script src="~/js/General/Messages_ar.js"></script>
		<script src="~/assets/plugins/custom/datatables/datatables.ar.js"></script>
	}
	else
	{
		<script src="~/js/General/Messages_en.js"></script>
		<script src="~/assets/plugins/custom/datatables/datatables.en.js"></script>
	}
	
	<script type="text/javascript">
		$(document).ready(function () {
			@await RenderSectionAsync("onReadyScript", required: false)
		});
    </script>
	<!--end::Javascript-->
</body>
<!--end::Body-->
</html>